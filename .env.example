# Django
SECRET_KEY=dev-walletapi-secret-key-change-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (local Postgres)
DB_NAME=walletapi
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Leave empty for local Postgres. Set only for a hosted database.
DATABASE_URL=

# Redis
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (development uses the console backend unless EMAIL_BACKEND is set)
DEFAULT_FROM_EMAIL=noreply@localhost

# CORS (comma-separated, used in production settings)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001

# DEBUG Swagger auto-login (ignored when DEBUG=False)
SWAGGER_SUPERUSER_USERNAME=swagger
SWAGGER_SUPERUSER_PASSWORD=swagger-admin-pass
