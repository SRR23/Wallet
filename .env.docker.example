# Copy to .env.docker for Docker Compose.
#   cp .env.docker.example .env.docker
#
# Compose overrides DB_HOST, Redis URLs, and clears DATABASE_URL so
# containers use the Compose Postgres and Redis.

SECRET_KEY=docker-dev-secret-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

DB_NAME=walletapi
DB_USER=postgres
DB_PASSWORD=postgres

# Host ports. Container ports stay 5432 / 6379 / 8000.
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6381
WEB_HOST_PORT=8001

DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001
DEFAULT_FROM_EMAIL=noreply@localhost
